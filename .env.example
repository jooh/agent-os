# Required by both the API and every worker. Role-specific values only override selection.
AGENT_OS_MODEL=openai:gpt-5.2
# AGENT_OS_PLANNER_MODEL=anthropic:claude-sonnet-4-6
# AGENT_OS_DEVELOPER_MODEL=openai:gpt-5.2
# AGENT_OS_REVIEWER_MODEL=openai:gpt-5.2
AGENT_OS_STATE_DIR=~/.local/state/agent-os
# Optional production override; the POC defaults to SQLite in AGENT_OS_STATE_DIR.
# DBOS_SYSTEM_DATABASE_URL=postgresql+psycopg://agent_os:agent_os@127.0.0.1:5432/agent_os
AGENT_OS_DEVELOPER_PARALLELISM=2
# POC range: 1..2. The planner response is rejected if it exceeds this limit.
AGENT_OS_PLANNER_TASK_LIMIT=2
AGENT_OS_MAX_ROUNDS=10
AGENT_OS_MAX_REVIEW_CYCLES=3
AGENT_OS_MAX_DEVELOPER_TURNS=6
AGENT_OS_MODEL_REQUEST_LIMIT=50
AGENT_OS_SHELL_TIMEOUT_SECONDS=900
